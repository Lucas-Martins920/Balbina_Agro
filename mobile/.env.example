# Copie para .env.local. Site de teste por padrão; o app da loja usa o site e o Supabase oficiais (perfil
# "producao" em eas.json). A chave é a publicável (a mesma NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY do site).
EXPO_PUBLIC_SITE_URL=http://SEU-COMPUTADOR-NA-REDE:3000
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO-DE-TESTE.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_AMBIENTE=teste
# Só para o site de teste protegido pela Vercel: segredo de Settings > Deployment Protection > Protection Bypass for Automation
EXPO_PUBLIC_VERCEL_BYPASS=
