# Copie para .env.local e preencha com os dados do projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# URL pública do app, usada no link de confirmação de e-mail
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Reference ID do projeto Supabase de PRODUÇÃO (Settings > General). Nas variáveis de Preview da Vercel ele faz o
# site de teste recusar o banco de produção (src/lib/ambiente.ts, scripts/vercel-ignorar.sh). Vazio na máquina.
BALBINA_REF_PRODUCAO=
# Cloudflare Turnstile (captcha do login, cadastro e "esqueci minha senha"). Vazio = sem captcha.
# A chave secreta vai no painel do Supabase (Authentication > Attack Protection), não aqui.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Só no servidor (nunca NEXT_PUBLIC_): chave secreta do Supabase, usada apenas pelos webhooks
SUPABASE_SECRET_KEY=
# Asaas das pisciculturas: não há chave no servidor. Cada piscicultura liga a própria conta em Cobranças (chave cifrada
# com BALBINA_CHAVE_CRIPTO, webhook com token próprio em /api/webhooks/asaas?perfil=<id>).
# Focus NFe: token da empresa (painel da Focus), ambiente (homologacao ou producao) e o token que este app manda no aviso automático
FOCUS_NFE_TOKEN=
FOCUS_NFE_AMBIENTE=homologacao
FOCUS_NFE_WEBHOOK_TOKEN=
# Token principal da conta Focus do Balbina (API de empresas): cadastra cada piscicultura como emitente, com o certificado A1 dela
FOCUS_NFE_TOKEN_REVENDA=
# Open Finance pela Pluggy (dashboard.pluggy.ai > Applications): extrato bancário automático na conciliação
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# 1 mostra os bancos de teste da Pluggy no widget (use só enquanto testa)
PLUGGY_SANDBOX=
# Texto aleatório que protege o webhook da Pluggy (vai no endereço do webhook)
PLUGGY_WEBHOOK_TOKEN=
# A Vercel manda este segredo na rotina diária que lê o extrato (Settings > Environment Variables)
CRON_SECRET=
# Assinatura do Balbina (SaaS): Asaas da SUA conta de fornecedor, que cobra as pisciculturas pelo uso do sistema.
# Separado do Asaas das pisciculturas acima. Webhook: https://SEU-ENDERECO/api/webhooks/assinatura com o token abaixo.
BALBINA_ASAAS_API_KEY=
# producao só no ambiente Production da Vercel: fora da produção (npm run dev) o app recusa o Asaas de produção (docs/asaas-producao.md)
BALBINA_ASAAS_AMBIENTE=sandbox
BALBINA_ASAAS_WEBHOOK_TOKEN=
# Dados do fornecedor que aparecem nos Termos de uso e na Política de privacidade
NEXT_PUBLIC_BALBINA_RAZAO_SOCIAL=
NEXT_PUBLIC_BALBINA_CNPJ=
NEXT_PUBLIC_BALBINA_EMAIL=
NEXT_PUBLIC_BALBINA_FORO=
# Segredo que cifra as chaves do Asaas de cada piscicultura guardadas no banco (texto aleatório, 32+ caracteres).
# Nunca troque depois de ligar contas: as chaves gravadas deixam de abrir.
BALBINA_CHAVE_CRIPTO=
# 1 tira o app do ar com a página "em manutenção" (telas e APIs respondem 503). Só na troca de servidor (docs/legado/finavi/migrar-sao-paulo.md)
BALBINA_MANUTENCAO=
# Avisos no celular (Web Push: lembrete de apontamento e outros). Gere com `npx web-push generate-vapid-keys`.
# Sem as duas chaves o botão de avisos não aparece e a rotina de automações não manda nada.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contato que vai junto dos avisos (exigido pelo protocolo)
VAPID_CONTATO=mailto:contato@seu-dominio.com.br

# IA (chat de manejo do app de campo, leitura de boleto/nota por foto): chave da API da Anthropic. Vazia = sem IA
# (o chat do campo continua lançando e respondendo pela base do celular).
ANTHROPIC_API_KEY=
# IA local sem internet (Ollama, docs/offline.md). No servidor (Balbina rodando num computador da fazenda): sem o
# Claude, passado o limite do mês ou sem internet, o chat pergunta ao Ollama. Vazio = desligado.
OLLAMA_URL=
OLLAMA_MODELO=mistral
# No celular/navegador sem internet: o app de campo pergunta direto ao Ollama. Precisa ser http://localhost (o
# próprio computador) ou um endereço https; o Ollama libera o site em OLLAMA_ORIGINS. Vale a partir do build.
NEXT_PUBLIC_OLLAMA_URL=
NEXT_PUBLIC_OLLAMA_MODELO=mistral
# Caixa de entrada por e-mail (provedor no formato Postmark Inbound): endereço de entrada sem o +token
# (ex.: notas@entrada.seu-dominio.com.br ou xxxx@inbound.postmarkapp.com) e a senha do webhook
# (URL: https://usuario:SENHA@app/api/entrada/email).
ENTRADA_EMAIL_ENDERECO=
ENTRADA_EMAIL_SEGREDO=

# WhatsApp do Balbina (API oficial da Meta, docs/automacoes.md › WhatsApp). Vazio = desligado.
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=
# número do Balbina para mostrar na tela (55 + DDD + número)
WHATSAPP_NUMERO=
# App secret do app da Meta (confere a assinatura do webhook) e o token de verificação do webhook
WHATSAPP_SEGREDO_APP=
WHATSAPP_VERIFICACAO=
# versão da Graph API (opcional)
WHATSAPP_API_VERSAO=v24.0

# Só para testar o modo offline no npm run dev (no dev o service worker fica desligado para poupar CPU)
# NEXT_PUBLIC_SW_DEV=1
